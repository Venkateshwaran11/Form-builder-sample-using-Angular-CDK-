{
  "version": 2,
  "framework": "angular",
  "crons": [
    {
      "path": "/api/cron/inactivity",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}